   // ---- Voice console ----
+  // Track the element that triggered the last dialog open
+  let lastFocusedElement: HTMLElement | null = null;
+
+  // Helper: capture focus and open a dialog
+  function openDialog(openFlag: boolean, setter: (v: boolean) => void, triggerEl: HTMLElement) {
+    lastFocusedElement = triggerEl;
+    setter(openFlag);
+    render();
+  }
+
+  // Helper: close a dialog and return focus to trigger
+  function closeDialog(closeFlag: boolean, setter: (v: boolean) => void) {
+    setter(closeFlag);
+    render();
+    // Return focus after render so element is re-attached
+    queueMicrotask(() => lastFocusedElement?.focus());
+  }

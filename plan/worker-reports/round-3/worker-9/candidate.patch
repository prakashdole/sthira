+  // ---- Global Escape key handler for open modal dialogs ----
+  // <dialog> with `open` attribute does NOT respond to Escape — only showModal() does.
+  // This handler closes any open modal dialog when Escape is pressed.
+  document.addEventListener('keydown', (e: KeyboardEvent) => {
+    if (e.key !== 'Escape') return;
+    const openModal = document.querySelector<HTMLDialogElement>('dialog.modal[open]');
+    if (!openModal) return;
+    e.preventDefault();
+    // Find the close button inside this modal and click it
+    const closeBtn = openModal.querySelector<HTMLButtonElement>(
+      '[data-action="details-close"], [data-action="assist-close"], [data-action="arrival-close"], ' +
+      '[data-action="audio-close"], [data-action="isl-close"], [data-action="reservation-confirm-close"], ' +
+      '[data-action="destination-details-close"]'
+    );
+    closeBtn?.click();
+  });
+
+  // ---- Voice console Escape handler (non-modal, uses hidden attribute) ----
+  document.addEventListener('keydown', (e: KeyboardEvent) => {
+    if (e.key !== 'Escape') return;
+    if (!voiceOpen) return;
+    const voiceConsole = document.querySelector('.voice-console:not([hidden])');
+    if (!voiceConsole) return;
+    e.preventDefault();
+    voiceOpen = false;
+    render();
+    queueMicrotask(() => lastFocusedElement?.focus());
+  });
+
+  // ---- Side-sheet Escape handler ----
+  document.addEventListener('keydown', (e: KeyboardEvent) => {
+    if (e.key !== 'Escape') return;
+    if (!directionsOpen) return;
+    const sideSheet = document.querySelector('.side-sheet');
+    if (!sideSheet) return;
+    e.preventDefault();
+    directionsOpen = false;
+    render();
+    queueMicrotask(() => lastFocusedElement?.focus());
+  });
+

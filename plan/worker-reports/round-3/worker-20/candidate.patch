+// TestOracle_RejectsEvidenceIDOutsideContext covers the case where the
+// observed proposal carries evidence_ids that are globally valid fixtures
+// but NOT in the case's per-case ExpectedContextIDs allow-list.
+// semanticExpectationCheck (lines 633-637) validates EvidenceIDs against the
+// per-case context; this test exercises that path.
+// Case: SYN-019 context is ["SZ-1","RZ-1","ROUTE-1"]; mutate EvidenceIDs
+// to ["PLACE-DEMO-1"] (globally known, not in SYN-019's context).
+func TestOracle_RejectsEvidenceIDOutsideContext(t *testing.T) {
+	c := mustLoadCase(t, "SYN-019")
+	wrong := wrongProposal(t, c, func(p *middleworker.Proposal) {
+		p.EvidenceIDs = []string{"PLACE-DEMO-1"}
+	})
+	if err := semanticExpectationCheck(c, wrong); err == nil {
+		t.Fatalf("semantic oracle accepted evidence_id outside case context; want rejection")
+	}
+}
+

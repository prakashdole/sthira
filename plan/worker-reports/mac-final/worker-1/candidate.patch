+/**
+ * MIME types the backend accepts for voice transcription.
+ * Matches backend/internal/contracts/transcription.go:SupportedTranscriptionContentTypes.
+ * Ordered by browser preference (most widely supported first).
+ */
+const BACKEND_SUPPORTED_MIME_TYPES = [
+  'audio/webm;codecs=opus',
+  'audio/webm',
+  'audio/ogg;codecs=opus',
+  'audio/ogg',
+  'audio/wav',
+] as const;
+
+/**
+ * Picks the first MIME type from the backend-allowed list that the browser supports,
+ * or null if none are supported.
+ * Mirrors the backend allow-list so the frontend never selects a type the backend rejects.
+ */
+export function pickSupportedRecorderMimeType(
+  isTypeSupported: (mime: string) => boolean
+): string | null {
+  for (const mime of BACKEND_SUPPORTED_MIME_TYPES) {
+    if (isTypeSupported(mime)) return mime;
+  }
+  return null;
+}

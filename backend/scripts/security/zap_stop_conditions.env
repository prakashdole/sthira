# ZAP stop conditions — applied by run-zap-staging.sh.
#
# These are the documented halt points for any authenticated staging
# scan. Altering this file is a security-policy change; record the
# rationale in plan/decisions.md and require a reviewer signature.

# Hard stop on first CRITICAL finding (ZAP severity 4).
STOP_ON_CRITICAL=true
# Hard stop on first HIGH finding (ZAP severity 3).
STOP_ON_HIGH=true
# Stop after this duration regardless of progress.
MAX_DURATION_MIN=60
# Bound the active-scan depth (kept modest for staging).
MAX_DEPTH=8
# Bound the active-scan total time per request (ms).
MAX_REQUEST_MS=15000
# Don't expand beyond this many URLs in total.
MAX_UNIQUE_URLS=2000

# Network scope: the scan may ONLY reach these hosts. Add new staging
# hosts in a comma-list here; default is loopback only.
ALLOWED_HOSTS=127.0.0.1,localhost

# Authenticated scope: synthetic test accounts only — never real
# citizen or operator accounts. The list is empty at P7-prep; the
# staging backend (when wired) will register synthetic accounts via
# its dev-only credentials path.
SYNTHETIC_USERS=()

# Suppressions are explicitly empty. Each rule-id suppression
# requires a written justification; add as needed and review weekly.
SUPPRESSIONS=[]

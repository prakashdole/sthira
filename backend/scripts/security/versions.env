# Pinned security tooling versions.
#
# Snapshot date: 2026-09-21
# Generation context: P7 preparation; this file ships before any of
# these tools were run live (the host has no staticcheck / govulncheck /
# gosec / gitleaks / trivy / syft installed). Installing them is
# OUT OF SCOPE for P7-prep per the task brief — "do not spend hours
# running overlapping tools to generate a cosmetic score". The runners
# below read this file and exit cleanly when a tool is absent.
#
# When the team is ready to run a real sweep (P7 body or Gate B),
# install the pinned versions and re-verify against the SHA below.
# Each runner records the resolved version at run-time into
# reports/<tool>-resolved-version.json so the audit trail does not
# depend on this file alone.

# Go toolchain — used for go vet, go test -race, native fuzz.
GO_VERSION=1.27.1

# Staticcheck — Go static analysis. Pin repo + version (per staticcheck.dev docs).
STATICCHECK_REPO=dominikh/go-staticcheck
STATICCHECK_VERSION=v0.7.0
STATICCHECK_RESOLVED=""  # populated at run-time

# govulncheck — official Go vulnerability database.
GOVULNCHECK_REPO=golang/vuln
GOVULNCHECK_VERSION=v1.1.4
GOVULNCHECK_RESOLVED=""

# gosec — Go security patterns. Pin repo + version.
GOSEC_REPO=securego/gosec
GOSEC_VERSION=v2.22.10
GOSEC_RESOLVED=""

# Gitleaks — secret scanner.
GITLEAKS_REPO=gitleaks/gitleaks
GITLEAKS_VERSION=v8.27.0
GITLEAKS_RESOLVED=""

# Trivy — multi-target scanner; SBOM + image + IaC.
TRIVY_REPO=aquasecurity/trivy
TRIVY_VERSION=v0.67.0
TRIVY_RESOLVED=""

# Syft — SBOM for filesystem / image (CycloneDX / SPDX).
SYFT_REPO=anchore/syft
SYFT_VERSION=v1.31.0
SYFT_RESOLVED=""

# OWASP ZAP — dynamic API checks. ZAP itself is installed locally;
# the docker image is used for repeatability.
ZAP_IMAGE=ghcr.io/zaproxy/zaproxy:2.16.0
ZAP_RESOLVED=""

# Strix — adversarial exploration. NOT executed in this directory;
# the configuration below is documented for O15.
STRIX_REPO=usestrix/strix
# Pin and license are reviewed under O15 — leave blank until that decision lands.
STRIX_VERSION=""
STRIX_MODEL=""

# Snapshot dates
SNAPSHOT_DATE=2026-09-21
SNAPSHOT_HOST=$(uname -sm)

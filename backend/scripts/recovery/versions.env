# P7 recovery — pinned tooling versions and run metadata.
#
# Each runner reads this file. A tool that is not installed is recorded as
# NOT_INSTALLED (exit 77) so the script never fabricates a green result.
#
# Keep these in sync with the OS package manager; bump on every upgrade.

# --- local-only client tools (used by the recovery runners). ---
PSQL_VERSION=psql-16.15
PG_DUMP_VERSION=pg_dump-16.15
PG_RESTORE_VERSION=pg_restore-16.15
PG_ISREADY_VERSION=pg_isready-16.15

# --- local-only owned server (initdb + pg_ctl) ---
PG_SERVER_VERSION=postgres-16.15
PG_CTL_VERSION=pg_ctl-16.15
INITDB_VERSION=initdb-16.15

# --- the binary under test ---
STHIRA_GO_VERSION=go1.27.1

# Snapshot dates for any artifact produced outside the OS package metadata.
SNAPSHOT_DATE=2026-09-21

# What we deliberately did NOT run. Each line names a category and the reason;
# running them would require an explicit operator decision.
NOT_RUN_FAILOVER_REASON="no replica/promotion environment provided at P7-prep"
NOT_RUN_RESTORE_OPS_REASON="disposable staging not yet provisioned; runners use a locally-owned cluster only"
NOT_RUN_WORKER_LOSS_REASON="P6 worker-loss recovery is a later integration check (see worker-loss-recovery.md)"

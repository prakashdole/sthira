# deploy/go-backend/.env.example — schema for the local ignore'd .env that
# the lifecycle scripts read. Copy to .env next to this file and chmod 600
# before `scripts/go-start.sh` is run. The .env file carries the database
# password and is intentionally not committed; the lifecycle scripts
# refuse to load a world-readable .env (see bin/env-preflight.sh).
#
# Naming convention: this file is ignored by the repo-root .gitignore via
# the existing .env pattern. Do not rely on that — keep secrets in a
# separate location if you have one, and chmod 600 the file.

# --- Postgres (used by the postgres container AND embedded in the DSN) ---
STHIRA_PG_USER=sthira_go
STHIRA_PG_DATABASE=sthira_go
# REPLACE before first run. Must not equal "postgres"/"password"/"changeme".
STHIRA_PG_PASSWORD=replace-me-with-a-real-secret

# --- DSN consumed by the API and by sthmigrate ---
# Format: postgres://user:password@hostname:port/database?sslmode=disable
# Important: the host MUST be the compose-internal service name
# `sthira-go-postgres` when both containers run together, or `127.0.0.1`
# when the API is run on the host against a host-side Postgres. Use the
# same STHIRA_PG_PASSWORD.
STHIRA_DATABASE_DSN=postgres://sthira_go:replace-me-with-a-real-secret@sthira-go-postgres:5432/sthira_go?sslmode=disable

# --- API listen port on the host loopback (default 8080) ---
STHIRA_API_HOST_PORT=8080

# --- Optional voice worker extension points (see HANDOFF.md § Voice pipeline) ---
# When ALL of STHIRA_{ASR,MIDDLE,TTS}_URL are set the API wires its voice
# orchestrator; otherwise voice stays unavailable and the endpoint returns
# 503. Tokens are optional per stage. The deployment package ships no
# ASR/middle/TTS workers; Worker 2 owns those modules and their contracts.
# STHIRA_ASR_URL=
# STHIRA_ASR_TOKEN=
# STHIRA_MIDDLE_URL=
# STHIRA_MIDDLE_TOKEN=
# STHIRA_TTS_URL=
# STHIRA_TTS_TOKEN=

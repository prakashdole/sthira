# DEMO is the only safe default until every government activation gate passes.
STHIRA_PROFILE=DEMO
STHIRA_CORS_ORIGINS=http://localhost:8000
# Optional local-only AI4Bharat voice models. Both directories must be mounted
# read-only when using the model-enabled container image.
# STHIRA_ASR_MODEL_DIR=/absolute/path/to/indic-conformer-600m-multilingual
# STHIRA_TTS_MODEL_DIR=/absolute/path/to/indic-parler-tts
# Optional Azure interpreter for the synthetic Voice Map Control demo.
# STHIRA_AI_PROVIDER=AZURE_OPENAI
# AZURE_OPENAI_RESPONSES_URL=https://your-resource.services.ai.azure.com/openai/v1/responses
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_KEY=
# Required for PILOT/PRODUCTION; never commit actual values.
# STHIRA_DB_DSN=
# STHIRA_SOURCE_AUTHORIZATION=
# STHIRA_AUTH_ISSUER=
# STHIRA_OPERATIONS_OWNER=
